{
  "name": "@absolutejs/marketplace",
  "version": "0.1.4",
  "description": "Provider-agnostic marketplace primitives for listings, criteria orders, auctions, trades, and atomic collectible settlement.",
  "type": "module",
  "license": "BSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/absolutejs/marketplace.git"
  },
  "homepage": "https://github.com/absolutejs/marketplace",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/manifest.ts --root ./src --outdir dist --sourcemap --target=bun && tsc --project tsconfig.build.json && absolute-manifest emit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:package": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.4.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "peerDependencies": {
    "@absolutejs/wallet": ">=0.8.6 <0.9"
  },
  "devDependencies": {
    "@absolutejs/wallet": "0.8.6",
    "@types/bun": "^1.3.14",
    "drizzle-orm": "1.0.0-rc.4",
    "typescript": "^5.9.0"
  },
  "absolutejs": {
    "manifestContract": 2
  }
}
